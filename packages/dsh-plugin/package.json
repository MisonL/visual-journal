{
    "name": "@visual-journal/dsh-plugin",
    "version": "0.2.0",
    "description": "DSH bundle that brings the Visual Journal Agent API into DeepSeek Harness",
    "type": "module",
    "main": "./lib/index.js",
    "exports": {
        ".": "./lib/index.js",
        "./cordis.patch.yml": "./cordis.patch.yml",
        "./package.json": "./package.json"
    },
    "files": [
        "lib",
        "cordis.patch.yml",
        "README.md"
    ],
    "engines": {
        "node": ">=22.15.0",
        "dsh": ">=0.2.1-rc.5 <0.3.0-0"
    },
    "dsh": {
        "manifestVersion": 1,
        "bundle": {
            "patch": "./cordis.patch.yml"
        }
    },
    "peerDependencies": {
        "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0-0",
        "@deepseek-ai/schemastery": "~3.18.5 || ~3.19.0"
    },
    "peerDependenciesMeta": {
        "@deepseek-ai/dsh-tools": {
            "optional": true
        },
        "@deepseek-ai/schemastery": {
            "optional": true
        }
    },
    "devDependencies": {
        "@deepseek-ai/cordis": "~4.1.0",
        "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
        "@deepseek-ai/schemastery": "~3.19.0",
        "js-yaml": "^4.3.1"
    },
    "scripts": {
        "test": "node --test test/*.test.mjs"
    }
}
